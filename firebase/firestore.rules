rules_version = '2';

// LEANgame accounts: Firestore security rules.
// Paste this file into Firebase console → Firestore Database → Rules, then press Publish.
// Project: leangame-3ee1b (Firestore in me-west1, Tel Aviv).
//
// Owner: the account that signed up with the username in OWNER_USERNAME (assets/js/firebase-config.js),
// whose Auth address is ownerEmail() below. On first login the owner pins their uid in config/owner;
// from then on the owner is that uid, even after the owner switches to a real recovery e-mail.
//
// Accounts log in with the username or the e-mail. Firebase Auth knows each one by an address: the e-mail,
// or (without one) a made-up "…@leangame.example" address (see loginEmail() in auth.js).
// usernames/{sha256('leangame-username:' + username)} holds { uid, username }, so each username is taken once.
// logins/{PBKDF2(username + password)} holds { uid, email }, so an account with an e-mail can log in with its
// username without the e-mail ever being public: only someone who knows the password can find the document.
//
// Roles (users/{uid}.role):
//   student, student_plus, student_premium   tiers; only an admin changes them
//   teacher   sees all users; may change a student's track and block / unblock students
//   admin     everything, except that only the owner touches other admins
//
// Data:
//   users/{uid}   { login (the Auth address), username, name, track: '3'|'4'|'5'|'uni'|'staff', role, blocked,
//                   progress (JSON string), createdAt, lastSeen, features?: [string], loginKey? }
//   usernames/{id}  { uid, username }
//   logins/{key}    { uid, email }
//   config/owner  { uid }   written once by the owner
//   config/staffInvite { code }   a teacher invite code, admins only (kept for special sign-up codes later;
//                                 for now the open staff link alone makes a teacher)
//   config/site   { signupOpen: { '3': bool, …, staff: bool } }  a student track missing from the map is open;
//                                                                 the staff link is closed unless set to true
//   config/tools  { tracks: { default?, '3'?, … } }  proof-tool settings per track (tools.js)

service cloud.firestore {
  match /databases/{database}/documents {

    function ownerUsername() { return 'admin'; }
    function ownerEmail() { return 'admin@leangame.example'; }

    function signedIn() { return request.auth != null; }
    function ownerDoc() { return /databases/$(database)/documents/config/owner; }
    function isOwner() {
      return signedIn() && (exists(ownerDoc())
        ? get(ownerDoc()).data.uid == request.auth.uid
        : request.auth.token.email == ownerEmail());
    }
    function myDoc() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function myRole() {
      return signedIn() && exists(myDoc()) ? get(myDoc()).data.get('role', 'student') : 'none';
    }
    function amBlocked() { return get(myDoc()).data.get('blocked', false) == true; }
    function isAdmin() { return isOwner() || (myRole() == 'admin' && !amBlocked()); }
    function isTeacher() { return myRole() == 'teacher' && !amBlocked(); }
    function isStaff() { return isAdmin() || isTeacher(); }

    function tiers() { return ['student', 'student_plus', 'student_premium']; }
    function roles() { return ['student', 'student_plus', 'student_premium', 'teacher', 'admin']; }
    function tracks() { return ['3', '4', '5', 'uni']; }

    function signupOpen(track) {
      let cfg = /databases/$(database)/documents/config/site;
      let open = exists(cfg) ? get(cfg).data.get('signupOpen', {}) : {};
      return track == 'staff' ? open.get('staff', false) == true : open.get(track, true) == true;
    }

    function validName(n) { return n is string && n.size() > 0 && n.size() <= 60; }
    function validUsername(u) { return u is string && u.size() > 0 && u.size() <= 64; }
    function validProgress(p) { return p is string && p.size() <= 200000; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function uhash(u) { return hashing.sha256('leangame-username:' + u).toHexString().lower(); }
    function usernameDoc(u) { return /databases/$(database)/documents/usernames/$(uhash(u)); }
    function claimedByMe(u) { return exists(usernameDoc(u)) && get(usernameDoc(u)).data.uid == request.auth.uid; }
    function inviteDoc() { return /databases/$(database)/documents/config/staffInvite; }
    function validInvite(c) {
      return c is string && c.size() >= 10 && exists(inviteDoc()) && get(inviteDoc()).data.code == c;
    }

    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isStaff();

      // Everyone creates their own profile once, under their own Auth address, as a plain student.
      // The owner creates theirs as admin in the staff track; others join a track whose sign-up is open.
      // The owner's username is reserved for the owner.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['login', 'username', 'name', 'track', 'role', 'blocked', 'progress', 'createdAt', 'lastSeen', 'invite'])
        && request.resource.data.login == request.auth.token.email
        && validUsername(request.resource.data.username)
        && claimedByMe(request.resource.data.username)
        && validName(request.resource.data.name)
        && request.resource.data.blocked == false
        && validProgress(request.resource.data.progress)
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastSeen == request.time
        && ((isOwner() && request.resource.data.role == 'admin' && request.resource.data.track == 'staff')
            || (!isOwner() && request.resource.data.username != ownerUsername()
                && ((request.resource.data.role == 'student'
                     && request.resource.data.track in tracks()
                     && signupOpen(request.resource.data.track))
                    // a teacher signs up through the staff link while the admin keeps it open
                    // (an optional invite code is stored for later; special sign-up codes are not required yet)
                    || (request.resource.data.role == 'teacher'
                        && request.resource.data.track == 'staff'
                        && signupOpen('staff')
                        && request.resource.data.get('invite', '') is string
                        && request.resource.data.get('invite', '').size() <= 64))));

      allow update: if
        // Admins change anything. Only the owner touches admins (including giving or removing the role).
        (isAdmin()
          && request.resource.data.get('role', 'student') in roles()
          && request.resource.data.get('features', []) is list
          && (isOwner()
              || (resource.data.get('role', 'student') != 'admin' && request.resource.data.get('role', 'student') != 'admin')))
        // Teachers change a student's track (to a student track) or blocked flag.
        || (isTeacher() && request.auth.uid != uid
            && resource.data.get('role', 'student') in tiers()
            && changed().hasOnly(['track', 'blocked'])
            && request.resource.data.track in tracks()
            && request.resource.data.blocked is bool)
        // Users change their own name, progress, last-seen time, login address (after a confirmed e-mail
        // change) and login key, set a username once on an older profile that has none, and not while blocked.
        || (signedIn() && request.auth.uid == uid
            && resource.data.blocked != true
            && changed().hasOnly(['name', 'progress', 'lastSeen', 'login', 'loginKey', 'username'])
            && validName(request.resource.data.name)
            && validProgress(request.resource.data.progress)
            && (!('lastSeen' in changed()) || request.resource.data.lastSeen == request.time)
            && (!('login' in changed()) || request.resource.data.login == request.auth.token.email)
            && (!('loginKey' in changed()) || request.resource.data.loginKey is string)
            && (!('username' in changed())
                || (!('username' in resource.data) && claimedByMe(request.resource.data.username))));

      allow delete: if isOwner() || (isAdmin() && resource.data.get('role', 'student') != 'admin');
    }

    // Each username once. Anyone may check whether a username is taken; nobody may list them.
    match /usernames/{id} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'username'])
        && request.resource.data.uid == request.auth.uid
        && validUsername(request.resource.data.username)
        && id == uhash(request.resource.data.username)
        && (request.resource.data.username != ownerUsername() || isOwner());
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Username login for accounts with an e-mail. The id is derived from the username and the password,
    // so the document (and the e-mail in it) can only be found by someone who knows the password.
    match /logins/{key} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'email'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Written once, by the owner, on their first login.
    match /config/owner {
      allow read: if true;
      allow create: if signedIn() && request.auth.token.email == ownerEmail()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
    }

    // The teacher invite code (#/join/staff/<code>). Only admins read or change it; the users rule above
    // compares a sign-up's code with it (rules can read it even though the person signing up cannot).
    match /config/staffInvite {
      allow read: if isAdmin();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['code'])
        && request.resource.data.code is string
        && request.resource.data.code.size() >= 10 && request.resource.data.code.size() <= 64;
    }

    match /config/site {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['signupOpen'])
        && request.resource.data.signupOpen is map;
    }

    // Proof-tool settings per track (written from the admin page, read by every student).
    match /config/tools {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['tracks'])
        && request.resource.data.tracks is map;
    }

    // Teacher question bank (qbank.js, author.js). Staff add questions; the author or an admin
    // edits or deletes them. Published questions are open to everyone, drafts to staff only.
    //   teacherQuestions/{id} { authorUid, authorName, title, stage ('L01'…), status: 'published'|'draft',
    //                           data (the problem, JSON), source (the words and the drawing, JSON),
    //                           createdAt, updatedAt }
    // A list query by someone who isn't staff must filter on status == 'published'.
    function validQuestion(d) {
      return d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.stage is string && d.stage.matches('L[0-9][0-9]')
        && d.status in ['published', 'draft']
        && d.data is string && d.data.size() <= 100000
        && d.source is string && d.source.size() <= 100000
        && d.authorName is string && d.authorName.size() <= 60
        // solved before published: a published question carries its author's accepted proof
        && d.get('solution', '') is string && d.get('solution', '').size() <= 100000
        && (d.status != 'published' || d.get('solution', '').size() > 2);
    }
    match /teacherQuestions/{id} {
      allow read: if resource.data.status == 'published' || isStaff();
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['authorUid', 'authorName', 'title', 'stage', 'status', 'data', 'source', 'solution', 'createdAt', 'updatedAt'])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && validQuestion(request.resource.data);
      allow update: if isStaff()
        && (resource.data.authorUid == request.auth.uid || isAdmin())
        && changed().hasOnly(['title', 'stage', 'status', 'data', 'source', 'solution', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && validQuestion(request.resource.data);
      allow delete: if isStaff() && (resource.data.authorUid == request.auth.uid || isAdmin());
    }
  }
}
